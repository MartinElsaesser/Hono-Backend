{
  "name": "backend",
  "version": "1.0.0",
  "main": "app.tsx",
  "type": "module",
  "scripts": {
    "db-init": "npm run db-init-schema && npm run db-seed",
    "db-seed": "tsx src/db/seed/index.ts",
    "db-gen-types": "kysely-codegen --out-file=src/db/schema/db-types.ts",
    "db-init-schema": "tsx src/db/schema/init-schema.ts",
    "prepare-debug": "npm run server:build && npm run client:build",
    "dev": "tsx watch src/server.tsx"
  },
  "author": "Martin Elsässer",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.5.0",
    "dotenv": "^16.5.0",
    "hono": "^4.7.9",
    "kysely": "^0.28.2",
    "pg": "^8.16.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/pg": "^8.15.1",
    "concurrently": "^9.1.2",
    "kysely-codegen": "^0.18.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
